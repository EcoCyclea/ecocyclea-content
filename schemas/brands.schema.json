{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecocyclea.fr/schemas/brands.schema.json",
  "title": "Ecocyclea — fichier source des marques (brands.fr-FR.json)",
  "type": "object",
  "required": ["rubricVersion", "brands"],
  "additionalProperties": false,
  "properties": {
    "rubricVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "tagline",
          "description",
          "categories",
          "labels",
          "sustainabilityHighlights",
          "score",
          "rubricVersion",
          "url",
          "priceRange",
          "reviewedBy",
          "reviewedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^brand-[0-9a-z][0-9a-z-]*$" },
          "name": { "type": "string", "minLength": 2, "maxLength": 60 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "tagline": { "type": "string", "minLength": 5, "maxLength": 120 },
          "description": { "type": "string", "minLength": 40, "maxLength": 300 },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "enum": [
                "culottes-menstruelles",
                "coupe-menstruelle",
                "tampons-serviettes-bio",
                "zero-dechet",
                "lingerie-soins"
              ]
            }
          },
          "labels": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "sustainabilityHighlights": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": { "type": "string", "minLength": 5, "maxLength": 140 }
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Score sur la grille (rubricVersion). Minimum 60 pour publier (contrôlé en CI)."
          },
          "rubricVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
          "url": { "type": "string", "format": "uri", "maxLength": 300 },
          "instagram": {
            "type": "string",
            "pattern": "^@?[a-zA-Z0-9._]{1,30}$"
          },
          "priceRange": { "enum": ["€", "€€", "€€€"] },
          "reviewedBy": { "type": "string", "minLength": 2, "maxLength": 80 },
          "reviewedAt": { "type": "string", "format": "date" },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
            "default": ["fr-FR"]
          }
        }
      }
    }
  }
}
